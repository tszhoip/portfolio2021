# Google Sheets API Configuration
#
# To use Google Sheets for project metadata:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a new project or select existing one
# 3. Enable "Google Sheets API"
# 4. Create API Key (Credentials > Create Credentials > API Key)
# 5. Copy the API key below
#
# For Sheet ID: Open your Google Sheet URL
# Sheet ID is the long string between /spreadsheets/d/ and /edit
# Example: https://docs.google.com/spreadsheets/d/1_19XPYR2QdK6QgrrHTEtIQySUafmgYdOLABhpmpTXDA/edit
# Sheet ID: 1_19XPYR2QdK6QgrrHTEtIQySUafmgYdOLABhpmpTXDA
#
# Make sure your Google Sheet is shared (at least "Viewer" access to public or specific users)

REACT_APP_GOOGLE_SHEETS_ID=your_sheet_id_here
REACT_APP_GOOGLE_SHEETS_API_KEY=your_api_key_here
